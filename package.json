{
  "name": "teo-crm",
  "version": "1.0.0",
  "private": true,
  "description": "CRM Omnichannel Multi-Tenant White-Label com IA (Téo) integrada ao WhatsApp, disparador de campanhas e rastreamento de SEO.",
  "scripts": {
    "dev": "node scripts/build-server.mjs && node --enable-source-maps dist/server.js",
    "dev:next": "next dev",
    "build": "next build && node scripts/build-server.mjs",
    "start": "NODE_ENV=production node --enable-source-maps dist/server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma db push --force-reset && prisma db seed",
    "postinstall": "prisma generate",
    "build:server": "node scripts/build-server.mjs",
    "start:render": "prisma db push --skip-generate && tsx prisma/seed-if-empty.ts && NODE_ENV=production node --enable-source-maps dist/server.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hello-pangea/dnd": "16.6.0",
    "@prisma/client": "5.22.0",
    "@radix-ui/react-dialog": "1.1.2",
    "@radix-ui/react-dropdown-menu": "2.1.2",
    "@radix-ui/react-popover": "1.1.2",
    "@radix-ui/react-slot": "1.1.0",
    "@radix-ui/react-switch": "1.1.1",
    "@radix-ui/react-tabs": "1.1.1",
    "@radix-ui/react-tooltip": "1.1.3",
    "@tanstack/react-query": "5.59.16",
    "bcryptjs": "2.4.3",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "cmdk": "1.0.0",
    "date-fns": "3.6.0",
    "jose": "5.9.6",
    "lucide-react": "0.453.0",
    "next": "14.2.15",
    "openai": "4.68.4",
    "papaparse": "5.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1",
    "sonner": "1.5.0",
    "tailwind-merge": "2.5.4",
    "tsx": "4.19.2",
    "xlsx": "0.18.5",
    "zod": "3.23.8",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.17.1",
    "@types/papaparse": "5.3.15",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "esbuild": "0.23.1",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "8.4.47",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.14",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
