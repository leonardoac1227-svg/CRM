# Banco (PostgreSQL / Supabase). No Supabase use a connection string do pooler em DATABASE_URL e a direta em DIRECT_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/crm?schema=public"

# Sessões (JWT HS256). Use um segredo longo e aleatório em produção.
JWT_SECRET="troque-por-um-segredo-com-mais-de-32-caracteres"

# Habilita o seletor de perfil no avatar (Gestor / Assistente / Corretor / Agência) sem senha.
DEMO_MODE="true"

# URL pública da aplicação (usada no tracker.js e nos webhooks)
APP_URL="http://localhost:3000"

# ---- Motor de IA (opcional: sem chave, o Téo usa o motor determinístico embutido) ----
# AI_PROVIDER = openai | gemini
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_TRANSCRIBE_MODEL="whisper-1"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# ---- WhatsApp Cloud API (Meta) ----
META_GRAPH_VERSION="v21.0"
META_WEBHOOK_VERIFY_TOKEN="teo-verify-token"
META_APP_SECRET=""

# ---- Evolution API (QR Code) ----
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""

# ---- Agendador ----
# server.ts roda as automações a cada minuto. Em serverless, desative e chame POST /api/cron/tick com
# Authorization: Bearer $CRON_SECRET (ex.: Vercel Cron).
DISABLE_SCHEDULER="false"
CRON_SECRET=""

# Vídeo de boas-vindas exibido em /getting-started (opcional)
NEXT_PUBLIC_WELCOME_VIDEO_URL=""
