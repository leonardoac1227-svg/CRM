# =============================================================================
#  Ápice — variáveis de ambiente
#  No Render elas ficam em: serviço › Environment. Localmente, copie para .env.
#  Passo a passo completo: docs/COLOCAR-NO-AR.md
# =============================================================================

# ---- Banco de dados (Supabase) ----
# Supabase › Project Settings › Database › Connection string.
# DATABASE_URL: "Transaction pooler" (porta 6543) + ?pgbouncer=true&connection_limit=1
# DIRECT_URL:   "Session pooler"     (porta 5432) — usado para criar/atualizar as tabelas
DATABASE_URL="postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
# Rodando com Postgres local (docker compose up db):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/crm?schema=public"

# ---- Arquivos do chat (Supabase Storage) ----
# Supabase › Project Settings › API. Sem estas variáveis os arquivos ficam no disco do servidor
# e somem a cada novo deploy no Render.
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="apice-uploads"

# ---- Segurança ----
# Segredo das sessões: um texto longo e aleatório (o Render gera sozinho).
JWT_SECRET="troque-por-um-segredo-com-mais-de-32-caracteres"

# ---- Primeira conta (criada só no primeiro start, com o banco vazio) ----
AGENCY_NAME="CRAP Digital"
ADMIN_NAME="Seu nome"
ADMIN_EMAIL="voce@suaempresa.com.br"
# Deixe em branco para gerar uma senha provisória (aparece nos logs do primeiro start).
ADMIN_PASSWORD=""

# ---- Endereço público ----
# No Render é preenchido sozinho (RENDER_EXTERNAL_URL). Defina se usar domínio próprio.
APP_URL=""

# ---- IA da Zeni (opcional: sem chave, a Zeni usa o motor de regras embutido) ----
# AI_PROVIDER = openai | gemini
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_TRANSCRIBE_MODEL="whisper-1"

# ---- WhatsApp oficial (Meta Cloud API) ----
# Cada número é configurado pela tela Integrações › WhatsApp. Estas são opcionais:
META_GRAPH_VERSION="v21.0"
# Token de verificação do webhook. Em branco, o Ápice gera um a partir do JWT_SECRET e mostra no assistente.
META_WEBHOOK_VERIFY_TOKEN=""
# Chave secreta de um app da Meta usado por todos os números (cada número também pode ter a sua).
META_APP_SECRET=""

# ---- WhatsApp por QR Code (Evolution API) ----
# Endereço e chave global do servidor Evolution API (veja o guia, passo "WhatsApp por QR Code").
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""

# ---- Agendador ----
# server.ts roda as automações a cada minuto. Em serverless, desative e chame POST /api/cron/tick com
# Authorization: Bearer $CRON_SECRET.
DISABLE_SCHEDULER="false"
CRON_SECRET=""
# Endereço que o agendador acessa a cada 10 min para manter um serviço vizinho acordado (opcional).
KEEPALIVE_URL=""

# Vídeo de boas-vindas exibido em /getting-started (opcional)
NEXT_PUBLIC_WELCOME_VIDEO_URL=""
